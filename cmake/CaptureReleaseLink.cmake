# zodiac_capture_release_link(<release_lib_dir>)
#
# Windows only, run at configure time. Asks the pinned llvm-mingw driver (CMAKE_CXX_COMPILER) how it links a static GUI release executable,
# "-### -static -mwindows -municode <ZODIAC_RELEASE_GAME_LINK_FLAGS> <placeholder object> -o <output>", and stores the ld.lld arguments relocatably.
# ZODIAC_RELEASE_GAME_LINK_FLAGS (cmake/ZodiacReleaseFlags.cmake, include it first) are the release link flags of every kit executable, so games are
# linked like them: -O3 -Wl,--gc-sections -s -flto=thin -Wl,--icf=safe, which the driver turns into --gc-sections, -s, --icf=safe and the ThinLTO
# options -plugin-opt=mcpu=x86-64, -plugin-opt=O3 and -plugin-opt=thinlto (kept as they are: they name no file).
# - <release_lib_dir>/link.txt: one argument per line. Every file of the toolchain becomes {release_lib}/crt/<file name> (an -l library is resolved the way
#   lld's MinGW driver does under -Bstatic, lib<name>.a then <name>.lib in each -L folder in order, and the -L folders are dropped), the output path
#   becomes {output} and the placeholder object {inputs}. cli/linker.hpp expands it.
# - <release_lib_dir>/toolchain.txt: "llvm-mingw <version> <crt> <arch>" without a line break, e.g. "llvm-mingw 20261104 ucrt x86_64": the version from
#   the toolchain's .stamp (written by bootstrap.py), ucrt when the linked libmsvcrt.a is the toolchain's libucrt.a (msvcrt otherwise), the arch from the driver's target.
# Sets ZODIAC_RELEASE_CRT_FILES in the caller's scope to the absolute toolchain files link.txt names, in link order; zodiac_kit_stage copies them to <release_lib_dir>/crt.
# Fails the configure, and so the kit build, when the driver runs no ld.lld (or more than one), when the line names a file it cannot copy (missing,
# outside the toolchain, an -l that does not resolve, two different files with one name) or uses an argument form it cannot relocate.
# The capture runs on every configure and the toolchain's .stamp is a configure dependency, so a toolchain change regenerates both files;
# they are only rewritten when their content changes.
include_guard(GLOBAL)
# Case-insensitive comparison key for a Windows path: '/' separators, normalized, lower case.
function(_zodiac_path_key out path)
file(TO_CMAKE_PATH "${path}" key)
cmake_path(NORMAL_PATH key)
string(TOLOWER "${key}" key)
set(${out} "${key}" PARENT_SCOPE)
endfunction()
# Writes lines (a list) with LF line breaks, file(WRITE) writing CRLF on Windows; file(CONFIGURE) leaves the file and its time stamp alone when
# the content is unchanged. Nothing in the lines is an @VAR@ reference.
function(_zodiac_write_lines file lines)
list(JOIN lines "\n" content)
file(CONFIGURE OUTPUT "${file}" CONTENT "${content}\n" @ONLY NEWLINE_STYLE UNIX)
endfunction()
# Writes text that holds no line break exactly as given, and only when it differs from the file's content.
function(_zodiac_write_text file text)
if(EXISTS "${file}")
file(READ "${file}" current)
if(current STREQUAL text)
return()
endif()
endif()
file(WRITE "${file}" "${text}")
endfunction()
function(zodiac_capture_release_link release_lib)
if(NOT ZODIAC_RELEASE_GAME_LINK_FLAGS)
message(FATAL_ERROR "Cannot capture the release link line: ZODIAC_RELEASE_GAME_LINK_FLAGS is not set; include cmake/ZodiacReleaseFlags.cmake first.")
endif()
cmake_path(GET CMAKE_CXX_COMPILER PARENT_PATH compiler_bin)
cmake_path(GET compiler_bin PARENT_PATH compiler_root)
set(stamp "${compiler_root}/.stamp")
if(NOT EXISTS "${stamp}")
message(FATAL_ERROR "Cannot capture the release link line: ${stamp} is missing. Install the toolchain with bootstrap.py.")
endif()
set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${stamp}")
file(READ "${stamp}" version)
string(STRIP "${version}" version)
set(work "${CMAKE_BINARY_DIR}/CMakeFiles/zodiac_release_link")
set(placeholder "${work}/zodiac_release_inputs.obj")
set(output "${work}/zodiac_release_output.exe")
file(MAKE_DIRECTORY "${work}")
# -### checks that the inputs exist, so the placeholder is a real (empty) file; nothing is compiled or linked.
file(WRITE "${placeholder}" "")
execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-###" -static -mwindows -municode ${ZODIAC_RELEASE_GAME_LINK_FLAGS} "${placeholder}" -o "${output}"
RESULT_VARIABLE result OUTPUT_VARIABLE driver_output ERROR_VARIABLE driver_output ENCODING UTF-8)
if(NOT result EQUAL 0)
message(FATAL_ERROR "Cannot capture the release link line: ${CMAKE_CXX_COMPILER} -### failed (${result}):\n${driver_output}")
endif()
string(REPLACE "\r" "" driver_output "${driver_output}")
string(REGEX MATCHALL "[^\n]+" driver_lines "${driver_output}")
set(arch "")
set(linker "")
set(arguments "")
foreach(line IN LISTS driver_lines)
if(line MATCHES "^Target: ([A-Za-z0-9_]+)-")
set(arch "${CMAKE_MATCH_1}")
endif()
if(NOT line MATCHES "^ \"")
continue()
endif()
# -### prints every argument in double quotes with ", \ and $ escaped by a backslash: the UNIX_COMMAND rules.
separate_arguments(tokens UNIX_COMMAND "${line}")
list(POP_FRONT tokens program)
cmake_path(GET program FILENAME program_name)
string(TOLOWER "${program_name}" program_name)
if(program_name MATCHES "^ld\\.lld(\\.exe)?$")
if(NOT linker STREQUAL "")
message(FATAL_ERROR "Cannot capture the release link line: the driver runs ld.lld more than once:\n${driver_output}")
endif()
set(linker "${program}")
set(arguments "${tokens}")
endif()
endforeach()
if(linker STREQUAL "")
message(FATAL_ERROR "Cannot capture the release link line: the driver runs no ld.lld:\n${driver_output}")
endif()
if(arch STREQUAL "")
message(FATAL_ERROR "Cannot capture the release link line: the driver did not print its target:\n${driver_output}")
endif()
# The toolchain is the folder above the linker's bin folder, as the driver names it.
cmake_path(GET linker PARENT_PATH linker_bin)
cmake_path(GET linker_bin PARENT_PATH root)
_zodiac_path_key(root_key "${root}")
_zodiac_path_key(placeholder_key "${placeholder}")
_zodiac_path_key(output_key "${output}")
set(lines "")
set(search_dirs "")
set(crt_files "")
set(crt_names "")
set(static FALSE)
set(expect_output FALSE)
foreach(argument IN LISTS arguments)
set(file "")
if(expect_output)
_zodiac_path_key(key "${argument}")
if(NOT key STREQUAL output_key)
message(FATAL_ERROR "Cannot capture the release link line: -o names \"${argument}\", not the requested output.")
endif()
list(APPEND lines "{output}")
set(expect_output FALSE)
continue()
endif()
if(argument STREQUAL "-o")
list(APPEND lines "-o")
set(expect_output TRUE)
continue()
endif()
if(argument MATCHES "^(-Bstatic|--Bstatic|-static|-dn|-non_shared)$")
set(static TRUE)
elseif(argument MATCHES "^(-Bdynamic|--Bdynamic|-dy|-call_shared)$")
set(static FALSE)
endif()
if(argument MATCHES "^-L(.+)$")
set(dir "${CMAKE_MATCH_1}")
_zodiac_path_key(key "${dir}/")
string(FIND "${key}" "${root_key}/" inside)
if(NOT inside EQUAL 0)
message(FATAL_ERROR "Cannot capture the release link line: \"${argument}\" is outside the toolchain ${root}.")
endif()
list(APPEND search_dirs "${dir}")
continue()
endif()
if(argument MATCHES "^-l(.+)$")
set(library "${CMAKE_MATCH_1}")
if(NOT static)
message(FATAL_ERROR "Cannot capture the release link line: \"${argument}\" is not linked statically.")
endif()
if(library MATCHES "^:(.+)$")
set(candidates "${CMAKE_MATCH_1}")
else()
set(candidates "lib${library}.a" "${library}.lib")
endif()
foreach(dir IN LISTS search_dirs)
foreach(candidate IN LISTS candidates)
if(EXISTS "${dir}/${candidate}" AND NOT IS_DIRECTORY "${dir}/${candidate}")
set(file "${dir}/${candidate}")
break()
endif()
endforeach()
if(NOT file STREQUAL "")
break()
endif()
endforeach()
if(file STREQUAL "")
message(FATAL_ERROR "Cannot capture the release link line: \"${argument}\" does not resolve in the toolchain's library folders (${search_dirs}).")
endif()
elseif(argument MATCHES "^(-l|-L)$")
message(FATAL_ERROR "Cannot capture the release link line: \"${argument}\" with a separate value is not supported.")
elseif(IS_ABSOLUTE "${argument}")
_zodiac_path_key(key "${argument}")
if(key STREQUAL placeholder_key)
list(APPEND lines "{inputs}")
continue()
endif()
string(FIND "${key}" "${root_key}/" inside)
if(NOT inside EQUAL 0)
message(FATAL_ERROR "Cannot capture the release link line: \"${argument}\" is outside the toolchain ${root}.")
endif()
set(file "${argument}")
else()
_zodiac_path_key(key "${argument}")
string(FIND "${key}" "${root_key}" inside)
if(NOT inside EQUAL -1)
message(FATAL_ERROR "Cannot capture the release link line: \"${argument}\" names the toolchain in a form that cannot be relocated.")
endif()
list(APPEND lines "${argument}")
continue()
endif()
# A toolchain file: copied into crt/ under its own name.
if(NOT EXISTS "${file}" OR IS_DIRECTORY "${file}")
message(FATAL_ERROR "Cannot capture the release link line: \"${file}\" is not a file that can be copied.")
endif()
cmake_path(GET file FILENAME name)
string(TOLOWER "${name}" name_key)
list(FIND crt_names "${name_key}" index)
if(index EQUAL -1)
list(APPEND crt_names "${name_key}")
list(APPEND crt_files "${file}")
else()
list(GET crt_files ${index} known)
_zodiac_path_key(known_key "${known}")
_zodiac_path_key(file_key "${file}")
if(NOT known_key STREQUAL file_key)
message(FATAL_ERROR "Cannot capture the release link line: \"${known}\" and \"${file}\" would both be crt/${name}.")
endif()
endif()
list(APPEND lines "{release_lib}/crt/${name}")
endforeach()
list(FIND lines "{inputs}" inputs_at)
list(FIND lines "{output}" output_at)
if(inputs_at EQUAL -1 OR output_at EQUAL -1)
message(FATAL_ERROR "Cannot capture the release link line: the placeholder object or the output is missing from it:\n${driver_output}")
endif()
# The C runtime the toolchain links by default: llvm-mingw's UCRT flavour installs its libucrt.a as libmsvcrt.a.
set(crt "")
foreach(file IN LISTS crt_files)
cmake_path(GET file FILENAME name)
string(TOLOWER "${name}" name)
if(name MATCHES "^libucrt(base)?\\.a$")
set(crt ucrt)
elseif(name STREQUAL "libmsvcrt.a")
cmake_path(GET file PARENT_PATH dir)
set(crt msvcrt)
if(EXISTS "${dir}/libucrt.a")
file(SHA256 "${file}" linked_hash)
file(SHA256 "${dir}/libucrt.a" ucrt_hash)
if(linked_hash STREQUAL ucrt_hash)
set(crt ucrt)
endif()
endif()
endif()
endforeach()
if(crt STREQUAL "")
message(FATAL_ERROR "Cannot capture the release link line: it links no C runtime library:\n${driver_output}")
endif()
file(MAKE_DIRECTORY "${release_lib}")
_zodiac_write_lines("${release_lib}/link.txt" "${lines}")
_zodiac_write_text("${release_lib}/toolchain.txt" "llvm-mingw ${version} ${crt} ${arch}")
set(ZODIAC_RELEASE_CRT_FILES "${crt_files}" PARENT_SCOPE)
endfunction()
