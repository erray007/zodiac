+// True when value lies exactly halfway between two adjacent floats, or at the float overflow threshold FLT_MAX+ulp/2.
+// Only such a double can make float(value) differ from the float nearest the decimal value that value is nearest to:
+// any float midpoint between that decimal and value is itself a double, nearer the decimal than value.
+bool asIsFloatMidpoint(double value)
+{
+const float nearest = float(value);
+if( double(nearest) == value )
+return false;
+if( std::isinf(nearest) )
+return std::fabs(value) == 0x1.ffffffp127;
+const float other = std::nextafter(nearest, double(nearest) < value ? std::numeric_limits<float>::infinity() : -std::numeric_limits<float>::infinity());
+// Two adjacent floats and their half sum are exact in double.
+return (double(nearest) + double(other)) * 0.5 == value;
