set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(ZODIAC_MINGW_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.tools/llvm-mingw")
cmake_path(NORMAL_PATH ZODIAC_MINGW_ROOT)
set(CMAKE_C_COMPILER "${ZODIAC_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang.exe")
set(CMAKE_CXX_COMPILER "${ZODIAC_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++.exe")
set(CMAKE_RC_COMPILER "${ZODIAC_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres.exe")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-static")
